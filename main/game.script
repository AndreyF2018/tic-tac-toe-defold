-- game.script - полная рабочая версия
local board = {}
local current_player = "x"
local game_over = false
local coins = 0

function init(self)
	coins = 0
	save_coins()
	reset_board()
	update_coins_display()
	print("Игра запущена! Ваш ход (X)")
end

function reset_board()
	for i = 1, 3 do
		board[i] = {}
		for j = 1, 3 do
			board[i][j] = ""
		end
	end
	current_player = "x"
	game_over = false
	msg.post("gui", "reset_board")
	msg.post("gui", "clear_winner_text")
	print("Доска очищена")
end

function load_coins()
	local data = sys.load("/coins_data")

	if data and data.coins then
		coins = data.coins
	else
		coins = 0
	end

	print("Загружено монет:", coins)
end

function save_coins()
	local data = { coins = coins }
	sys.save("/coins_data", data)
	print("Сохранено монет:", coins)
end

function update_coins_display()
	msg.post("gui", "update_coins", {coins = coins})
end

function check_winner()
	for i = 1, 3 do
		if board[i][1] ~= "" and board[i][1] == board[i][2] and board[i][2] == board[i][3] then
			return board[i][1]
		end
	end
	for j = 1, 3 do
		if board[1][j] ~= "" and board[1][j] == board[2][j] and board[2][j] == board[3][j] then
			return board[1][j]
		end
	end
	if board[1][1] ~= "" and board[1][1] == board[2][2] and board[2][2] == board[3][3] then
		return board[1][1]
	end
	if board[1][3] ~= "" and board[1][3] == board[2][2] and board[2][2] == board[3][1] then
		return board[1][3]
	end

	local is_full = true
	for i = 1, 3 do
		for j = 1, 3 do
			if board[i][j] == "" then
				is_full = false
				break
			end
		end
	end
	if is_full then
		return "draw"
	end
	return nil
end

function ai_move()
	if game_over then return end

	local empty_cells = {}
	for i = 1, 3 do
		for j = 1, 3 do
			if board[i][j] == "" then
				table.insert(empty_cells, {x = i, y = j})
			end
		end
	end

	if #empty_cells == 0 then return end

	local random_index = math.random(#empty_cells)
	local move = empty_cells[random_index]

	board[move.x][move.y] = "o"
	msg.post("gui", "update_cell", {x = move.x, y = move.y, value = "o"})

	local winner = check_winner()
	if winner then
		handle_game_end(winner)
		return
	end

	current_player = "x"
	print("Ваш ход (X)")
end

function handle_game_end(winner)
	game_over = true
	local message = ""

	if winner == "x" then
		coins = coins + 10
		message = "WIN! +10 coins"
		print("Зlayer won! Coins:", coins)
	elseif winner == "o" then
		message = "LOSE! 0 coins"
		print("AI won")
	elseif winner == "draw" then
		coins = coins + 5
		message = "DRAW! +5 coins"
		print("Ничья! Монет:", coins)
	end

	save_coins()
	update_coins_display()
	msg.post("gui", "show_winner", {text = message})
end

function on_message(self, message_id, message)
	if message_id == hash("cell_click") then
		if game_over then
			print("Игра закончена, нажмите Reset")
			return
		end

		if current_player ~= "x" then
			print("Сейчас ход компьютера")
			return
		end

		local x = message.x
		local y = message.y

		if board[x][y] ~= "" then
			print("Клетка занята")
			return
		end

		board[x][y] = "x"
		msg.post("gui", "update_cell", {x = x, y = y, value = "x"})

		local winner = check_winner()
		if winner then
			handle_game_end(winner)
			return
		end

		current_player = "o"
		print("Ход компьютера (O)")

		timer.delay(0.5, false, function()
			ai_move()
		end)

	elseif message_id == hash("reset") then
		reset_board()
	end
end